{
  "name": "mycoach",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/dev.ts",
    "dev:ui": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.server.json",
    "start": "node server-dist/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup": "node --import tsx server/cli.ts setup",
    "db:import": "node --import tsx server/cli.ts import",
    "db:backup": "node --import tsx server/cli.ts backup",
    "db:restore": "node --import tsx server/cli.ts restore",
    "host:configure": "node --import tsx server/cli.ts host",
    "release": "npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "better-sqlite3": "^12.4.0",
    "fastify": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "twemoji": "^14.0.2",
    "zod": "^4.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
