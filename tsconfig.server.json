{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "server-dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "src/db/types.ts"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
